# Optional 1Click partner credentials. Leave blank for the public 0.2% fee.
# Never commit real values. .env is gitignored.
ONECLICK_API_KEY=
ONECLICK_JWT=

# Secrets for the enclave program (set in OutLayer, never commit real values)
AEGIS_POLICY_SECRET_HEX=        # 32-byte X25519 secret that opens borrower policies (64 hex chars)
AEGIS_SIGNING_KEY_HEX=          # 32-byte Ed25519 seed that signs decisions (64 hex chars)
AEGIS_ORACLE_PUBKEY=            # pinned ed25519:... key of price-oracle
AEGIS_ATTESTATION_SHA256=       # sha256 of the enclave wasm
AEGIS_RECIPIENT=                # account that receives the swap output (the borrower's position account)
AEGIS_REFUND_TO=                # refund address on the origin chain
AEGIS_LIVE=0                    # 1 = ask for a real (non-dry) 1Click quote
AEGIS_QUOTE_FIXTURE=            # path to a saved 1Click response for offline runs
